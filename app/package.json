{
  "name": "sivrce",
  "version": "1.0.0",
  "private": true,
  "browserslist": [
    "chrome >= 111",
    "edge >= 111",
    "firefox >= 111",
    "safari >= 16.4",
    "not dead"
  ],
  "scripts": {
    "dev": "node scripts/copy-maplibre-worker.mjs && next dev",
    "prebuild": "node scripts/copy-maplibre-worker.mjs && node ../scripts/check-repo-weight.mjs --ci && npx --yes tsx src/lib/attribution.check.ts && npx --yes tsx src/lib/cdn-cache.check.ts && npx --yes tsx src/lib/device-budget.check.ts && npx --yes tsx src/lib/avatar.check.ts && npx --yes tsx src/lib/admin/admin-guard.check.ts && npx --yes tsx src/lib/admin/system.check.ts && npx --yes tsx src/lib/map/map-geo.check.ts && npx --yes tsx src/lib/map/maplibre-worker.check.ts && npx --yes tsx src/lib/map/cadastre.check.ts && npx --yes tsx src/lib/hero-quick.check.ts && npx --yes tsx src/lib/listings-home-rail.check.ts && npx --yes tsx src/lib/suggest-match.check.ts && npx --yes tsx src/app/api/suggest/route.check.ts && npx --yes tsx src/lib/llms-txt.check.ts && npx --yes tsx src/lib/seo-canonical.check.ts && npx --yes tsx src/lib/i18n.check.ts && npx --yes tsx src/lib/market-stats.check.ts && npx --yes tsx src/lib/building-score.check.ts && npx --yes tsx src/lib/reviews/reviews.check.ts && npx --yes tsx src/lib/bilingual.check.ts && npx --yes tsx src/lib/ai.check.ts && npx --yes tsx src/components/chat/messages.check.ts && npx --yes tsx src/lib/faq.check.ts && npx --yes tsx src/lib/legal/docs.check.ts && npx --yes tsx src/lib/sun.check.ts && npx --yes tsx src/lib/map/sun-shadow.check.ts && npx --yes tsx src/data/blog.check.ts && npx --yes tsx 'src/app/[lang]/projects/card.check.ts' && npx --yes tsx --conditions=react-server src/lib/weather.check.ts && npx --yes tsx --conditions=react-server src/lib/land.check.ts && npx --yes tsx src/lib/trust/dedupe-core.check.ts && npx --yes tsx src/lib/host-redirect.check.ts && npx --yes tsx src/lib/country-copy.check.ts && npx --yes tsx src/lib/geo-market.check.ts && npx --yes tsx src/lib/map/user-place.check.ts && (node scripts/og-derivatives.mjs || echo 'og-derivatives skipped') && (npx --yes tsx scripts/gen-footer-cols.ts || echo 'footer-cols skipped')",
    "build": "NODE_OPTIONS=--max-old-space-size=4096 next build",
    "start": "NODE_OPTIONS=--max-old-space-size=768 next start",
    "lint": "eslint",
    "check:map": "npx --yes tsx src/lib/map/buildings.check.ts",
    "check:pin": "npx --yes tsx src/lib/map/footprint-pin.check.ts",
    "check:admin": "npx --yes tsx src/lib/admin/admin-guard.check.ts && npx --yes tsx src/lib/admin/system.check.ts",
    "check:i18n": "npx --yes tsx src/lib/i18n.check.ts",
    "check:market": "npx --yes tsx src/lib/market-stats.check.ts",
    "check:score": "npx --yes tsx src/lib/building-score.check.ts",
    "check:reviews": "npx --yes tsx src/lib/reviews/reviews.check.ts",
    "check:bilingual": "npx --yes tsx src/lib/bilingual.check.ts",
    "check:sun": "npx --yes tsx src/lib/sun.check.ts",
    "check:sun-shadow": "npx --yes tsx src/lib/map/sun-shadow.check.ts",
    "check:land": "npx --yes tsx --conditions=react-server src/lib/land.check.ts",
    "check:chat": "npx --yes tsx src/components/chat/messages.check.ts",
    "check:pois": "npx --yes tsx src/lib/map/pois.check.ts",
    "check:attribution": "npx --yes tsx src/lib/map/attribution.check.ts",
    "check:geocode": "npx --yes tsx src/lib/map/geocode.check.ts",
    "check:ai": "npx --yes tsx src/lib/ai.check.ts",
    "check:search": "npx --yes tsx src/lib/search.check.ts",
    "check:suggest": "npx --yes tsx src/lib/suggest-match.check.ts",
    "check:suggest-route": "npx --yes tsx src/app/api/suggest/route.check.ts",
    "check:geo": "npx --yes tsx src/lib/geo/nearest-poi.check.ts",
    "check:villages": "npx --yes tsx src/data/georgia-villages.check.ts",
    "check:cron": "npx --yes tsx src/lib/jobs/expire-and-sync.check.ts",
    "check:dedupe": "npx --yes tsx src/lib/trust/dedupe-core.check.ts",
    "check:sms": "npx --yes tsx src/lib/sms/twilio-verify.check.ts",
    "check:auth-phone": "npx --yes tsx src/lib/auth-phone.check.ts",
    "check:avatar": "npx --yes tsx src/lib/avatar.check.ts",
    "check:projects": "npx --yes tsx 'src/app/[lang]/projects/card.check.ts'",
    "check:live": "npx --yes tsx src/lib/platform-live.check.ts",
    "check:passkey": "npx --yes tsx src/lib/auth-passkey.check.ts",
    "check:auth-passkey": "npx --yes tsx src/lib/auth-passkey.check.ts",
    "check:ads": "npx --yes tsx src/lib/ads.check.ts",
    "check:listing-share": "npx --yes tsx src/lib/listing-share.check.ts",
    "check:seo-title": "npx --yes tsx src/lib/seo-title.check.ts",
    "check:seo-hub": "npx --yes tsx src/lib/seo-hub.check.ts",
    "check:faq": "npx --yes tsx src/lib/faq.check.ts",
    "check:legal": "npx --yes tsx src/lib/legal/docs.check.ts",
    "check:llms": "npx --yes tsx src/lib/llms-txt.check.ts",
    "check:cdn": "npx --yes tsx src/lib/cdn-cache.check.ts",
    "check:device": "npx --yes tsx src/lib/device-budget.check.ts && npx --yes tsx src/lib/map/map-geo.check.ts",
    "check:home-rail": "npx --yes tsx src/lib/listings-home-rail.check.ts",
    "check:media": "npx --yes tsx src/lib/media.check.ts",
    "directory:localize": "npx --yes tsx scripts/localize-directory.ts",
    "directory:mirror": "npx --yes tsx scripts/localize-directory.ts --mirror-only --heroes",
    "directory:logos": "npx --yes tsx scripts/sync-developer-logos.ts",
    "directory:seed-listings": "npx --yes tsx scripts/seed-project-listings.ts",
    "vapid:gen": "node -e \"const w=require('web-push');const k=w.generateVAPIDKeys();console.log('NEXT_PUBLIC_VAPID_PUBLIC_KEY='+k.publicKey);console.log('VAPID_PRIVATE_KEY='+k.privateKey);console.log('VAPID_SUBJECT=mailto:info@sivrce.ge');\"",
    "postinstall": "prisma generate",
    "prepare": "sh ../scripts/setup-hooks.sh",
    "mobile:sync": "npx cap sync",
    "mobile:ios": "npx cap sync ios && npx cap open ios",
    "mobile:android": "npx cap sync android && npx cap open android",
    "mobile:dev": "NEXT_PUBLIC_CAPACITOR=true next dev -p 3000",
    "mobile:build": "next build && npx cap sync",
    "check:seo-slug": "npx --yes tsx src/lib/listing-slug.check.ts",
    "check:services": "npx --yes tsx src/lib/services.check.ts",
    "check:napr": "npx --yes tsx src/lib/map/napr-parcel.check.ts",
    "check:cadastre": "npx --yes tsx src/lib/map/cadastre.check.ts",
    "check:tas": "npx --yes tsx src/lib/map/tas-arch.check.ts",
    "check:site": "npx --yes tsx src/lib/map/site-lookup.check.ts && npx --yes tsx src/lib/map/osm-building-ring.check.ts && npx --yes tsx src/lib/map/osm-corpus.check.ts && npx --yes tsx src/lib/map/berlin-gov.check.ts",
    "check:cms": "npx --yes tsx src/lib/cms.check.ts && npx --yes tsx src/lib/cms-studio.check.ts",
    "check:competitor-import": "npx --yes tsx src/lib/competitor-import.check.ts",
    "check:listing-video": "npx --yes tsx src/lib/listing-video.check.ts",
    "check:indexnow": "npx --yes tsx src/lib/indexnow.check.ts",
    "check:repo-weight": "node ../scripts/check-repo-weight.mjs --self-check && node ../scripts/check-repo-weight.mjs --ci --verbose",
    "ingest:buildings": "npx --yes tsx scripts/ingest-osm-buildings.ts",
    "ingest:buildings:all": "npx --yes tsx scripts/ingest-osm-buildings.ts --city=all",
    "ingest:alkis": "npx --yes tsx scripts/ingest-alkis-buildings.ts",
    "check:berlin-gov": "npx --yes tsx src/lib/map/berlin-gov.check.ts",
    "check:de": "npx --yes tsx src/lib/countries/de.check.ts",
    "ingest:de-intel": "npx --yes tsx scripts/ingest-de-intel.ts",
    "napr:snap": "npx --yes tsx scripts/snap-napr-pins.ts",
    "tas:snap": "npx --yes tsx scripts/snap-official-footprints.ts",
    "official:snap": "npx --yes tsx scripts/snap-official-footprints.ts",
    "check:blog": "npx --yes tsx src/data/blog.check.ts",
    "media:backfill-avif": "node scripts/r2-backfill-avif.mjs"
  },
  "dependencies": {
    "@ai-sdk/google": "^4.0.62",
    "@auth/prisma-adapter": "^2.11.3",
    "@aws-sdk/client-s3": "^3.1124.0",
    "@aws-sdk/s3-request-presigner": "^3.1124.0",
    "@base-ui/react": "^1.7.0",
    "@capacitor/android": "^8.5.1",
    "@capacitor/cli": "^8.5.1",
    "@capacitor/core": "^8.5.1",
    "@capacitor/ios": "^8.5.1",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.3",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@sentry/nextjs": "^10.73.0",
    "@simplewebauthn/browser": "^13.3.0",
    "@simplewebauthn/server": "^13.3.3",
    "ai": "^7.0.90",
    "botid": "^1.5.11",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.4.2",
    "framer-motion": "^12.43.0",
    "lucide-react": "^1.39.0",
    "maplibre-gl": "^6.6.0",
    "meilisearch": "^0.60.0",
    "next": "16.3.4",
    "next-auth": "^5.0.0-beta.32",
    "next-themes": "^0.4.6",
    "pg": "^8.23.0",
    "posthog-js": "^1.425.1",
    "prisma": "^7.10.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "resend": "^6.25.0",
    "server-only": "^0.0.1",
    "sharp": "^0.34.5",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "playwright": "^1.62.1",
    "shadcn": "^4.20.0",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5"
  }
